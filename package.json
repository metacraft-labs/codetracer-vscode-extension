{
  "name": "ct-vscode",
  "displayName": "CodeTracer",
  "repository": {
    "type": "git",
    "url": "https://github.com/metacraft-labs/codetracer-vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/metacraft-labs/codetracer-vscode-extension/issues"
  },
  "publisher": "metacraft-labs",
  "description": "",
  "icon": "./public/extension/codetracer_marketplace_logo.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.92.0"
  },
  "enabledApiProposals": [
    "editorInsets"
  ],
  "preview": true,
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onDebugResolve:codetracer-debug",
    "onCommand:ct-vscode.toggleCT",
    "onCommand:ct-vscode.loadCurrentFile",
    "onCommand:ct-vscode.loadRecentTraces"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "CodeTracer",
      "properties": {
        "codetracer.runnablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the CodeTracer binary"
        },
        "codetracer.rrWorkerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ct-rr-support (RR worker) executable used for rr-based traces"
        },
        "codetracer.rrExePath": {
          "type": "string",
          "default": "",
          "description": "Path to the rr executable used by ct-rr-support (optional; falls back to PATH or bundled rr)"
        }
      }
    },
    "debuggers": [
      {
        "type": "codetracer-debug",
        "label": "Codetracer Debugger",
        "languages": [
          "noir",
          "ruby",
          "rust"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program",
              "traceFolder"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to executable"
              },
              "traceFolder": {
                "type": "string",
                "description": "Path to the trace folder containing .json files"
              }
            }
          }
        }
      }
    ],
    "commands": [
      {
        "command": "ct-vscode.toggleCT",
        "title": "Toggle CodeTracer"
      },
      {
        "command": "ct-vscode.addTracepoint",
        "title": "Add Tracepoint"
      },
      {
        "command": "ct-vscode.loadCurrentFile",
        "title": "Record and run current active editor file"
      },
      {
        "command": "ct-vscode.loadRecentTraces",
        "title": "Load from a list of recent traces"
      },
      {
        "command": "ct-vscode.loadRecentTransactions",
        "title": "Load from a list of recent transactions"
      },
      {
        "command": "ct-vscode.openCalltrace",
        "title": "Open Calltrace Panel",
        "category": "CodeTracer"
      },
      {
        "command": "ct-vscode.openState",
        "title": "Open State Panel",
        "category": "CodeTracer"
      },
      {
        "command": "ct-vscode.openScratchpad",
        "title": "Open Scratchpad Panel",
        "category": "CodeTracer"
      },
      {
        "command": "ct-vscode.openEventLog",
        "title": "Open Event Log Panel",
        "category": "CodeTracer"
      },
      {
        "command": "ct-vscode.openTerminalOutput",
        "title": "Open Terminal Output Panel",
        "category": "CodeTracer"
      },
      {
        "command": "ct-vscode.smartSourceLineJump",
        "title": "Jump to line",
        "category": "CodeTracer"
      },
      {
        "command": "ct-vscode.forwardSourceLineJump",
        "title": "Jump forward to line",
        "category": "CodeTracer"
      },
      {
        "command": "ct-vscode.backwardSourceLineJump",
        "title": "Jump backward to line",
        "category": "CodeTracer"
      },
      {
        "command": "ct-vscode.addToScratchpad",
        "title": "Add to Scratchpad",
        "category": "CodeTracer"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ct-vscode.smartSourceLineJump",
          "when": "codetracer:active",
          "group": "navigation"
        },
        {
          "command": "ct-vscode.forwardSourceLineJump",
          "when": "codetracer:active",
          "group": "navigation"
        },
        {
          "command": "ct-vscode.backwardSourceLineJump",
          "when": "codetracer:active",
          "group": "navigation"
        },
        {
          "command": "ct-vscode.addToScratchpad",
          "when": "codetracer:active",
          "group": "codetracerSpecific"
        },
        {
          "command": "ct-vscode.addTracepoint",
          "when": "codetracer:active",
          "group": "codetracerSpecific"
        }
      ]
    },
    "keybindings": [],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codetracer-sidebar-view",
          "title": "CodeTracer",
          "icon": "./public/extension/codetracer_vscode_logo.svg"
        }
      ]
    },
    "views": {
      "codetracer-sidebar-view": [
        {
          "type": "webview",
          "id": "codetracer-sidebar-panel",
          "name": "CodeTracer"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "just build",
    "compile": "echo 'ERROR: npm run compile only compiles TypeScript and produces an incomplete build.' && echo 'Use `just build` for a full build (Nim + Rust + TypeScript).' && echo 'Use `npm run compile:ts` if you only need TypeScript type-checking.' && exit 1",
    "compile:ts": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile:ts && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:wdio": "npx wdio run wdio.conf.ts",
    "test:wdio:hello": "npx wdio run wdio.conf.ts --spec test/wdio/specs/hello-vscode.e2e.ts",
    "test:wdio:stylus": "npx wdio run wdio.conf.ts --spec test/wdio/specs/stylus-trace-load.e2e.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.92.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/dts": "^0.4.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@wdio/cli": "^9.19.2",
    "@wdio/globals": "^9.19.2",
    "@wdio/local-runner": "^9.19.2",
    "@wdio/mocha-framework": "^9.19.2",
    "@wdio/spec-reporter": "^9.19.2",
    "chromedriver": "^138.0.5",
    "wdio-chromedriver-service": "^8.1.1",
    "wdio-vscode-service": "^6.1.3",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "build": "^0.1.4",
    "just": "^0.1.8"
  }
}
