{
  "name": "ct-vscode",
  "displayName": "CodeTracer",
  "description": "",
  "icon": "codetracer_vscode_logo.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "debuggers": [
      {
        "type": "codetracer-debug",
        "label": "Codetracer Debugger",
        "program": "/home/nedy/codetracer-github/src/build-debug/bin/db-backend",
        "args": [
          "--stdio"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the trace folder containing .json files"
              }
            }
          }
        }
      }
    ],
    "commands": [
      {
        "command": "ct-vscode.toggleCT",
        "title": "Toggle CodeTracer"
      },
      {
        "command": "ct-vscode.openCalltrace",
        "title": "Open Calltrace Panel",
        "category": "CodeTracer"
      },
      {
        "command": "ct-vscode.openState",
        "title": "Open State Panel",
        "category": "CodeTracer"
      },
      {
        "command": "ct-vscode.openScratchpad",
        "title": "Open Scratchpad Panel",
        "category": "CodeTracer"
      },
      {
        "command": "ct-vscode.openEventLog",
        "title": "Open Event Log Panel",
        "category": "CodeTracer"
      },
      {
        "command": "ct-vscode.openTerminalOutput",
        "title": "Open Terminal Output Panel",
        "category": "CodeTracer"
      }
    ],
    "keybindings": [
      {
        "command": "ct-vscode.nextStep",
        "key": "f10",
        "when": "editorTextFocus"
      },
      {
        "key": "enter",
        "command": "ct-vscode.onEnter",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codetracer-sidebar-view",
          "title": "CodeTracer",
          "icon": "./public/extension/codetracer_vscode_logo.svg"
        }
      ]
    },
    "views": {
      "codetracer-sidebar-view": [
        {
          "type": "webview",
          "id": "codetracer-sidebar-panel",
          "name": "CodeTracer"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.92.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "build": "^0.1.4",
    "just": "^0.1.8"
  }
}